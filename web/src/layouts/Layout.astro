---
import { ClientRouter } from 'astro:transitions';
import Brand from '@/components/Brand.astro';
import Icon from '@/components/Icon.astro';
import PageHeader from '@/components/PageHeader.astro';
import SideNav from '@/components/SideNav.astro';
import ThemeToggle from '@/components/ThemeToggle';
import FilterPanel from '@/components/filters/FilterPanel';
import { pageTransition } from '@/lib/transitions';
import '@/styles/index.css';

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · SaludVital - Centro Médico Ambulatorio</title>
    <ClientRouter />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <!-- Aplica tema y estado del menú antes de pintar (evita parpadeos): preferencia guardada o del sistema -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var t = null;
        var s = null;
        try {
          t = localStorage.getItem('saludvital:tema');
          s = localStorage.getItem('saludvital:sidebar');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = t;
        root.dataset.sidebar = s === 'pinned' ? 'pinned' : 'collapsed';

        // Con View Transitions el <html> se reemplaza: conserva tema y estado del menú en el documento nuevo
        document.addEventListener('astro:before-swap', function (e) {
          e.newDocument.documentElement.dataset.theme = root.dataset.theme;
          e.newDocument.documentElement.dataset.sidebar = root.dataset.sidebar;
        });
      })();
    </script>
  </head>
  <body>
    <div class="app">
      <aside class="app__sidebar" id="sidebar" transition:persist="sidebar" transition:animate="none">
        <div class="side-head">
          <Brand />
        </div>

        <SideNav />

        <!-- En el riel colapsado solo se ve un icono; al expandir aparece el panel completo -->
        <div class="side-rail-hint" title="Filtros globales"><Icon name="filtros" /></div>
        <div class="side-collapsible">
          <FilterPanel client:only="react" />
        </div>

        <div class="side-foot">
          <ThemeToggle client:only="react" />
          <button type="button" class="side-btn side-pin" data-sidebar-toggle aria-pressed="false" aria-label="Fijar menú lateral expandido" title="Fijar menú">
            <Icon name="panel" size={18} />
          </button>
        </div>
      </aside>

      <main class="app__main" transition:animate={pageTransition}>
        <PageHeader title={title} subtitle={subtitle} />
        <slot />
      </main>
    </div>

    <script>
      import '@/scripts/sidebar';
    </script>
  </body>
</html>
