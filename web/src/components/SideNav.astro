---
import { NAV_ITEMS } from '@/lib/nav';
import Icon from './Icon.astro';

const trim = (p: string) => p.replace(/\/+$/, '');
const base = trim(import.meta.env.BASE_URL);
const current = trim(Astro.url.pathname);

const items = NAV_ITEMS.map((i) => {
  const href = `${base}/${i.href}`;
  return { ...i, href, active: trim(href) === current };
});
---

<nav class="nav" aria-label="Navegación">
  {
    items.map((i) => (
      <a class="nav__link" href={i.href} aria-current={i.active ? 'page' : undefined} title={i.label}>
        <Icon name={i.icon} />
        <span class="side-text">{i.label}</span>
      </a>
    ))
  }
</nav>
