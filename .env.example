# Copia este archivo a .env para personalizar los puertos de docker compose.
STREAMLIT_PORT=8501
WEB_PORT=8080
WEB_DEV_PORT=4321

# Subruta de despliegue del dashboard Astro (solo si se sirve detrás de un proxy con prefijo).
# nginx dentro del contenedor sirve en la raíz, por lo que normalmente debe quedar en "/".
SITE_BASE=/
