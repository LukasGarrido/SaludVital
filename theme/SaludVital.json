{
  "name": "SaludVital High Contrast",
  "dataColors": [
    "#8E2430",
    "#1B4D48",
    "#C86D1F",
    "#285B8E",
    "#5B3765",
    "#3B7A57",
    "#B33B5B",
    "#4A5568"
  ],
  "background": "#FAF6F0",
  "foreground": "#241C1B",
  "tableAccent": "#8E2430",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FAF6F0"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E6DCD0"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D4C4B0"
              }
            },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#241C1B"
              }
            },
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#8E2430"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#6E1A24"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#1B4D48"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "icon": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "weight": 2
          }
        ]
      }
    }
  }
}