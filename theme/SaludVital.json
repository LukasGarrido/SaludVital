
{
  "name": "SaludVital Minimal Red & Graphite",
  "dataColors": [
    "#B8323E",
    "#E05A64",
    "#D9A0A2",
    "#85838A",
    "#C58B72",
    "#6F737B",
    "#A94A50"
  ],
  "background": "#F4F1EF",
  "foreground": "#29272A",
  "tableAccent": "#B8323E",
  "textClasses": {
    "callout": {
      "color": "#29272A",
      "fontFace": "Figtree"
    },
    "title": {
      "color": "#29272A",
      "fontFace": "Figtree"
    },
    "header": {
      "color": "#29272A",
      "fontFace": "Figtree"
    },
    "label": {
      "color": "#77737A",
      "fontFace": "Figtree"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EAE6E4"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E2E0"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#29272A"
              }
            },
            "fontSize": 13,
            "fontFamily": "Figtree"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#343036"
              }
            },
            "fontFamily": "Figtree"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#343036"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#343036"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#85838A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8F6F5"
              }
            },
            "fontFamily": "Figtree"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#B8323E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1E8E7"
              }
            },
            "fontFamily": "Figtree"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#343036"
              }
            },
            "fontFamily": "Figtree"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#343036"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F4F1EF"
              }
            },
            "fontFamily": "Figtree"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#343036"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#85838A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8F6F5"
              }
            },
            "fontFamily": "Figtree"
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#B8323E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1E8E7"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#B8323E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1E8E7"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#343036"
              }
            },
            "fontFamily": "Figtree"
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#B8323E"
              }
            }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#B8323E"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#912832"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#343036"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 11,
            "fontFamily": "Figtree"
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "icon": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "weight": 2
          }
        ]
      }
    }
  }
}
