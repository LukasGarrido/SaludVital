
{
  "name": "SaludVital Modern Light",
  "dataColors": ["#3478B8", "#7564B8", "#E58A42", "#D5A72F", "#20A6A6", "#D65F72", "#42966A", "#8874C9"],
  "background": "#F0F4F8",
  "foreground": "#34465A",
  "tableAccent": "#3478B8",
  "visualStyles": {
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#EDF2F7" } }, "transparency": 0 }],
                     "outspace": [{ "color": { "solid": { "color": "#EDF2F7" } }, "transparency": 0 }] } },
    "*": { "*": {
      "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
      "border": [{ "show": true, "color": { "solid": { "color": "#D8E1EB" } }, "radius": 12 }],
      "title": [{ "show": true, "fontColor": { "solid": { "color": "#34465A" } }, "fontSize": 14, "fontFamily": "Segoe UI Semibold" }]
    } }
  }
}
