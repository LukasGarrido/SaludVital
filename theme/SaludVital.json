{
  "name": "SaludVital Dark",
  "dataColors": ["#2F8CFF", "#9575CD", "#E8741A", "#D4B21A", "#1FB5C9", "#D94F6A", "#1E8A3C", "#6A5AA8"],
  "background": "#1B2358",
  "foreground": "#FFFFFF",
  "tableAccent": "#E8741A",
  "visualStyles": {
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#0A1045" } }, "transparency": 0 }],
                     "outspace": [{ "color": { "solid": { "color": "#0A1045" } }, "transparency": 0 }] } },
    "*": { "*": {
      "background": [{ "color": { "solid": { "color": "#1B2358" } }, "transparency": 0 }],
      "border": [{ "show": true, "color": { "solid": { "color": "#3A4A9A" } }, "radius": 14 }],
      "title": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 14, "fontFamily": "Segoe UI Semibold" }]
    } }
  }
}