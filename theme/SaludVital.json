{
  "name": "SaludVital Dark",
  "dataColors": [
    "#E05A6D",
    "#4FB3A8",
    "#3B82F6",
    "#F59E0B",
    "#10B981",
    "#8B5CF6",
    "#EC4899"
  ],
  "background": "#0B1215",
  "foreground": "#FFFFFF",
  "tableAccent": "#E05A6D",
  "textClasses": {
    "callout": { "color": "#FFFFFF", "fontFace": "Figtree" },
    "title": { "color": "#FFFFFF", "fontFace": "Figtree" },
    "header": { "color": "#FFFFFF", "fontFace": "Figtree" },
    "label": { "color": "#FFFFFF", "fontFace": "Figtree" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0B1215" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#080E11" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#131C21" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#223038" } },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 14,
            "fontFamily": "Figtree"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1B272E" } },
            "fontFamily": "Figtree"
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#FFFFFF" } },
            "backColorPrimary": { "solid": { "color": "#131C21" } },
            "backColorSecondary": { "solid": { "color": "#182329" } },
            "fontFamily": "Figtree"
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1B272E" } },
            "fontFamily": "Figtree"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1B272E" } },
            "fontFamily": "Figtree"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#131C21" } },
            "fontFamily": "Figtree"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#FFFFFF" } },
            "backColorPrimary": { "solid": { "color": "#131C21" } },
            "backColorSecondary": { "solid": { "color": "#182329" } },
            "fontFamily": "Figtree"
          }
        ],
        "subTotals": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1B272E" } }
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1B272E" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Figtree"
          }
        ],
        "header": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": { "solid": { "color": "#E05A6D" } },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": { "solid": { "color": "#C04A5D" } },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": { "solid": { "color": "#4FB3A8" } },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 11,
            "fontFamily": "Figtree"
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "icon": [
          {
            "$id": "default",
            "show": true,
            "lineColor": { "solid": { "color": "#FFFFFF" } },
            "weight": 2
          }
        ]
      }
    }
  }
}